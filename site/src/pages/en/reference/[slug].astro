---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { referenceSections, getNavItems, getPrevNext } from '../../../i18n/navigation';

export async function getStaticPaths() {
  const entries = await getCollection('reference');
  return referenceSections.map((section) => {
    const entry = entries.find((e) => e.id === section.file);
    return {
      params: { slug: section.slug },
      props: { entry, sectionMeta: section },
    };
  });
}

const { entry, sectionMeta } = Astro.props;
const items = getNavItems(referenceSections, 'en', 'reference');
const { prev, next } = getPrevNext(referenceSections, sectionMeta.slug, 'en', 'reference');

const { Content } = entry ? await render(entry) : { Content: null };
---

<DocLayout
  title={sectionMeta.title.en}
  pageTitle={sectionMeta.pageTitle?.en}
  section="reference"
  items={items}
  currentSlug={sectionMeta.slug}
  prevItem={prev}
  nextItem={next}
>
  {Content ? <Content /> : <p class="text-senar-500">Content not found.</p>}
</DocLayout>
