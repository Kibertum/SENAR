---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../../layouts/DocLayout.astro';
import { guideSections, getNavItems, getPrevNext } from '../../../i18n/navigation';

export async function getStaticPaths() {
  const entries = await getCollection('guideRu');
  return guideSections.map((section) => {
    const entry = entries.find((e) => e.id === section.file);
    return {
      params: { slug: section.slug },
      props: { entry, sectionMeta: section },
    };
  });
}

const { entry, sectionMeta } = Astro.props;
const items = getNavItems(guideSections, 'ru', 'guide');
const { prev, next } = getPrevNext(guideSections, sectionMeta.slug, 'ru', 'guide');

const { Content } = entry ? await render(entry) : { Content: null };
---

<DocLayout
  title={sectionMeta.title.ru}
  pageTitle={sectionMeta.pageTitle?.ru}
  section="guide"
  items={items}
  currentSlug={sectionMeta.slug}
  prevItem={prev}
  nextItem={next}
>
  {Content ? <Content /> : <p class="text-senar-500">Контент переводится. <a href={`/en/guide/${sectionMeta.slug}/`} class="underline">Читать на английском</a>.</p>}
</DocLayout>
